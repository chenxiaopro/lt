# 复制本文件为 .env 后即可生效。一键安装脚本会自动生成，一般不用手改。
JWT_SECRET=请改成足够长的随机字符串
PORT=3001
NODE_ENV=production

# 后台装扮 AI，由站点自行填写，不要复用平台环境变量
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-v4-pro

# 三楼电台搜歌（自建 NeteaseCloudMusicApiEnhanced 根地址）
# 网站根目录执行 bash 安装电台接口.sh 会自动写入，例如 http://127.0.0.1:3000
YY_API=

# 网易云登录 Cookie，填了才能听整首；留空则只有 30 秒试听/无地址
# 浏览器登录 music.163.com 后，从开发者工具复制请求头 Cookie 里的 MUSIC_U=...
YY_COOKIE=

# 单个视频上传上限（MB），范围 1-200。调高后同步调整 Nginx 的 client_max_body_size
VIDEO_MAX_MB=80
